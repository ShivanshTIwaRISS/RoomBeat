# Backend
PORT=3000
NODE_ENV=development
DATABASE_URL=postgresql://roombeat:roombeat_dev_pass@localhost:5432/roombeat
JWT_SECRET=roombeat_dev_jwt_secret_change_in_production
JWT_EXPIRES_IN=7d
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=52428800
CORS_ORIGIN=*

# PostgreSQL (Docker Compose)
POSTGRES_USER=roombeat
POSTGRES_PASSWORD=roombeat_dev_pass
POSTGRES_DB=roombeat

# Mobile App
API_BASE_URL=http://YOUR_LAN_IP:3000

